# Site Configuration
# Copy this file to .env only when overriding local defaults.

# User-page deployment defaults. Keep PUBLIC_BASE=/ for ssooop.github.io.
SITE_URL=https://ssooop.github.io
PUBLIC_BASE=/

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
PLAUSIBLE_ANALYTICS_DOMAIN=

# API Keys (if needed)
# API_KEY=your_api_key_here
