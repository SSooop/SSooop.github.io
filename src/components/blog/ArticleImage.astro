---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  source?: string;
  sourceUrl?: string;
  sourcePrefix?: string;
  variant?: 'default' | 'wide' | 'full' | 'compact';
  aspect?: 'auto' | '16:9' | '4:3' | '1:1' | '21:9';
  tone?: 'plain' | 'paper' | 'ink';
  priority?: boolean;
}

const {
  src,
  alt,
  caption,
  source,
  sourceUrl,
  sourcePrefix = 'Source',
  variant = 'default',
  aspect = 'auto',
  tone = 'paper',
  priority = false,
} = Astro.props as Props;

const isLocalAsset = typeof src !== 'string';
const loading = priority ? 'eager' : 'lazy';
const decoding = priority ? 'sync' : 'async';
const hasCaption = Boolean(caption || source);
const getExternalUrl = (value?: string) => {
  if (!value) return undefined;

  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:' ? value : undefined;
  } catch {
    return undefined;
  }
};
const sourceHref = sourceUrl ?? getExternalUrl(source);
const sourceLabel = sourceHref ? sourcePrefix : source;
const sourceTitle = sourceHref && source ? source : undefined;
---

<figure class:list={['article-image', `article-image--${variant}`, `article-image--${tone}`]}>
  <div class:list={['article-image__media', `article-image__media--${aspect.replace(':', 'x')}`]}>
    {
      isLocalAsset ? (
        <Image
          src={src}
          alt={alt}
          loading={loading}
          decoding={decoding}
          widths={[640, 960, 1280, 1600]}
          sizes={
            variant === 'compact'
              ? '(min-width: 768px) 560px, calc(100vw - 2rem)'
              : '(min-width: 1024px) 896px, calc(100vw - 2rem)'
          }
        />
      ) : (
        <img src={src} alt={alt} loading={loading} decoding={decoding} />
      )
    }
  </div>

  {
    hasCaption && (
      <figcaption class="article-image__caption">
        {caption && <span>{caption}</span>}
        {source && (
          <span class="article-image__source">
            {caption && <span aria-hidden="true"> / </span>}
            {sourceHref ? (
              <a
                class="article-image__source-tag"
                href={sourceHref}
                target="_blank"
                rel="noopener noreferrer"
                title={sourceTitle}
                aria-label={`Open original source: ${source}`}
              >
                {sourceLabel}
              </a>
            ) : (
              <>
                {sourcePrefix}: {sourceLabel}
              </>
            )}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .article-image {
    width: min(100%, 44rem);
    margin: 2.75rem auto;
    color: color-mix(in srgb, var(--color-morandi-text), transparent 32%);
  }

  .article-image--default {
    max-width: 44rem;
  }

  .article-image--compact {
    width: min(100%, 34rem);
  }

  .article-image--wide,
  .article-image--full {
    max-width: 44rem;
  }

  .article-image__media {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-morandi-accent-2), transparent 36%);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1)),
      var(--color-morandi-bg);
    box-shadow: 0 22px 54px rgb(74 74 74 / 0.13);
  }

  .article-image--plain .article-image__media {
    background: transparent;
    box-shadow: none;
  }

  .article-image--ink .article-image__media {
    background: var(--color-morandi-text);
    border-color: rgb(255 255 255 / 0.16);
    box-shadow: 0 24px 60px rgb(74 74 74 / 0.2);
  }

  .article-image__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 420ms ease,
      filter 420ms ease;
  }

  .article-image__media--auto :global(img) {
    height: auto;
    object-fit: contain;
  }

  .article-image:hover .article-image__media :global(img) {
    transform: scale(1.018);
    filter: saturate(1.03) contrast(1.02);
  }

  .article-image__media--16x9 {
    aspect-ratio: 16 / 9;
  }

  .article-image__media--4x3 {
    aspect-ratio: 4 / 3;
  }

  .article-image__media--1x1 {
    aspect-ratio: 1 / 1;
  }

  .article-image__media--21x9 {
    aspect-ratio: 21 / 9;
  }

  .article-image__caption {
    max-width: 40rem;
    margin: 0.8rem auto 0;
    padding-inline: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.7;
    text-align: center;
  }

  .article-image__source {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.35rem;
    vertical-align: middle;
  }

  .article-image__source-tag {
    display: inline-flex;
    min-height: 1.35rem;
    align-items: center;
    justify-content: center;
    padding: 0.14rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-track-intellipharma), transparent 58%);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-track-intellipharma), transparent 90%);
    color: var(--color-track-intellipharma);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .article-image__source-tag:hover {
    border-color: color-mix(in srgb, var(--color-track-intellipharma), transparent 30%);
    background: color-mix(in srgb, var(--color-track-intellipharma), transparent 82%);
    color: var(--color-morandi-text);
  }
</style>
