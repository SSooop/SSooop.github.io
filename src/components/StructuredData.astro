---
/**
 * StructuredData Component - JSON-LD for SEO
 *
 * Generates JSON-LD structured data for schema.org markup
 * Supports: WebSite, Person, BlogPosting, BreadcrumbList
 */

interface StructuredDataProps {
  data: Record<string, unknown>;
  type?: string;
}

const { data, type } = Astro.props as StructuredDataProps;

const jsonData = {
  '@context': 'https://schema.org',
  ...(type ? { '@type': type } : {}),
  ...data,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonData, null, 2)} />
