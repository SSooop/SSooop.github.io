---
interface Props {
  src: string;
  alt: string;
  label: string;
  index: string;
  credit: string;
  sourceUrl: string;
  class?: string;
  eager?: boolean;
  theme?: 'light' | 'dark';
  position?: 'relative' | 'absolute';
  edge?: 'standard' | 'hero';
}

const {
  src,
  alt,
  label,
  index,
  credit,
  sourceUrl,
  class: className = '',
  eager = false,
  theme = 'dark',
  position = 'relative',
  edge = 'standard',
} = Astro.props;
---

<figure
  class:list={[
    'specimen group overflow-hidden',
    position === 'absolute' ? 'absolute' : 'relative',
    className,
  ]}
  data-theme={theme}
  data-edge={edge}
>
  <img
    src={src}
    alt={alt}
    class="atlas-image-treatment absolute inset-0 h-full w-full object-cover"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
  />
  <div class="specimen__veil absolute inset-0" aria-hidden="true"></div>
  <div class="specimen__edge absolute inset-2 z-[8]" aria-hidden="true"></div>
  <div class="specimen__crosshair specimen__crosshair--top" aria-hidden="true"></div>
  <div class="specimen__crosshair specimen__crosshair--bottom" aria-hidden="true"></div>
  <figcaption
    class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-6 p-4 md:p-5"
  >
    <div>
      <p class="font-mono text-[10px] tracking-[0.18em] uppercase">{label}</p>
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 block max-w-md font-mono text-[9px] leading-relaxed opacity-65 transition-opacity hover:opacity-100"
      >
        {credit}
      </a>
    </div>
    <span class="font-mono text-[10px] tracking-[0.18em]">{index}</span>
  </figcaption>
</figure>

<style>
  .specimen {
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: var(--atlas-radius);
    background: var(--color-atlas-ink);
    box-shadow: var(--atlas-shadow);
    color: rgb(255 255 255 / 0.9);
  }

  .specimen[data-theme='light'] {
    border-color: var(--atlas-line);
    color: var(--color-atlas-ink);
  }

  .specimen[data-edge='hero'] {
    border-color: rgb(229 231 224 / 0.46);
    box-shadow:
      0 28px 70px rgb(7 12 19 / 0.2),
      0 0 0 1px rgb(17 24 39 / 0.32),
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 0 48px rgb(3 8 18 / 0.22);
  }

  .specimen__edge {
    pointer-events: none;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: calc(var(--atlas-radius) - 0.25rem);
    box-shadow:
      inset 0 0 0 1px rgb(2 8 23 / 0.22),
      0 0 28px rgb(120 167 211 / 0.08);
    opacity: 0;
  }

  .specimen[data-edge='hero'] .specimen__edge {
    opacity: 1;
  }

  .specimen__veil {
    background: linear-gradient(180deg, transparent 45%, rgb(7 12 19 / 0.7) 100%);
  }

  .specimen[data-theme='light'] .specimen__veil {
    background: linear-gradient(180deg, transparent 48%, rgb(234 229 223 / 0.92) 100%);
  }

  .specimen__crosshair {
    position: absolute;
    z-index: 10;
    width: 1.25rem;
    height: 1.25rem;
    border-color: currentColor;
    opacity: 0.55;
  }

  .specimen__crosshair--top {
    top: 1rem;
    left: 1rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .specimen__crosshair--bottom {
    right: 1rem;
    bottom: 1rem;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }
</style>
