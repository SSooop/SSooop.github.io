---
import Layout from '../layouts/Layout.astro';

const title = '智药深瞳 | Alex Su（苏晨鹏）';
const description =
  '智药深瞳（IntelliPharma Insights）是 Alex Su（苏晨鹏）的双语研究与写作网站，关注 AI、生物医药、科学软件与长期价值。';
const alternateLanguages = {
  en: '/en/',
  zh: '/zh/',
  'x-default': '/',
};
---

<Layout
  title={title}
  lang="zh"
  description={description}
  canonical="/"
  alternateLanguages={alternateLanguages}
>
  <main class="relative flex min-h-[100svh] items-center overflow-hidden px-5 py-20 md:px-10">
    <div
      class="pointer-events-none absolute inset-0 opacity-70"
      aria-hidden="true"
      style="background:
        radial-gradient(circle at 72% 24%, color-mix(in srgb, var(--color-track-intellipharma), transparent 84%), transparent 34%),
        linear-gradient(135deg, transparent 0 48%, color-mix(in srgb, var(--atlas-line), transparent 40%) 49%, transparent 50%);"
    >
    </div>

    <div class="relative mx-auto w-full max-w-6xl">
      <p class="atlas-kicker mb-8">INTELLIPHARMA INSIGHTS / ALEX SU</p>

      <header class="max-w-5xl">
        <h1 class="text-atlas-ink font-serif text-[clamp(4.4rem,14vw,10rem)] leading-[0.82]">
          智药深瞳
        </h1>
        <p
          class="text-track-intellipharma mt-5 font-mono text-xs tracking-[0.16em] uppercase md:text-sm"
          lang="en"
        >
          IntelliPharma Insights
        </p>
        <p
          class="text-atlas-ink/80 mt-10 max-w-3xl font-serif text-2xl leading-relaxed md:text-4xl"
        >
          Alex Su <span aria-hidden="true">/</span> 苏晨鹏
        </p>
        <p class="text-atlas-ink/65 mt-6 max-w-3xl text-base leading-8 md:text-lg">
          聚焦 AI、生物医药、科学软件与长期价值的双语研究和写作。
          <span class="block" lang="en">
            Bilingual research and writing on AI, biopharma, scientific software, and long-term
            value.
          </span>
        </p>
      </header>

      <nav
        class="mt-14 grid max-w-3xl gap-3 border-t border-[color:var(--atlas-line)] pt-6 sm:grid-cols-2"
        aria-label="选择语言 / Choose a language"
      >
        <a
          href="/zh/"
          lang="zh-CN"
          class="group border border-[color:var(--atlas-line)] px-5 py-4 transition-colors hover:bg-white/35"
        >
          <span class="atlas-kicker block">中文</span>
          <span class="text-atlas-ink mt-2 block font-serif text-2xl">
            进入苏晨鹏的研究档案 <span aria-hidden="true">→</span>
          </span>
        </a>
        <a
          href="/en/"
          lang="en"
          class="group border border-[color:var(--atlas-line)] px-5 py-4 transition-colors hover:bg-white/35"
        >
          <span class="atlas-kicker block">ENGLISH</span>
          <span class="text-atlas-ink mt-2 block font-serif text-2xl">
            Enter Alex Su’s research archive <span aria-hidden="true">→</span>
          </span>
        </a>
      </nav>
    </div>
  </main>
</Layout>
