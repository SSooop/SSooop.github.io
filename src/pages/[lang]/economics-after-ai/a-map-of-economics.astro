        localName: 'F. A. Hayek',
        years: '1899—1992',
        idea: '分散知识、价格信号与自发秩序。',
        works: ['《知识在社会中的运用》', '《自由秩序原理》'],
      },
      samuelson: {
        name: '保罗·萨缪尔森',
        localName: 'Paul Samuelson',
        years: '1915—2009',
        idea: '最优化、比较静态与新古典综合。',
        works: ['《经济分析基础》'],
      },
      friedman: {
        name: '米尔顿·弗里德曼',
        localName: 'Milton Friedman',
        years: '1912—2006',
        idea: '货币、永久收入、预期与政策规则。',
        works: ['《美国货币史》', '《货币政策的作用》'],
      },
      lucas: {
        name: '小罗伯特·卢卡斯',
        localName: 'Robert Lucas Jr.',
        years: '1937—2023',
        idea: '理性预期、宏观模型的微观基础与系统性政策的局限。',
        works: ['《经济计量学的政策评估：一个批判》', '《预期与货币中性》'],
      },
      coase: {
        name: '罗纳德·科斯',
        localName: 'Ronald Coase',
        years: '1910—2013',
        idea: '交易成本、产权与制度选择。',
        works: ['《企业的性质》', '《社会成本问题》'],
      },
      akerlof: {
        name: '乔治·阿克洛夫',
        localName: 'George Akerlof',
        years: '1940—',
        idea: '信息不对称、逆向选择与脆弱的市场。',
        works: ['《柠檬市场》'],
      },
      kahneman: {
        name: '丹尼尔·卡尼曼',
        localName: 'Daniel Kahneman',
        years: '1934—2024',
        idea: '判断、框架、参照点与损失厌恶。',
        works: ['《前景理论》', '《思考，快与慢》'],
      },
      ostrom: {
        name: '埃莉诺·奥斯特罗姆',
        localName: 'Elinor Ostrom',
        years: '1933—2012',
        idea: '共有资源、持久规则与多中心自治。',
        works: ['《公共事务的治理之道》'],
      },
      romer: {
        name: '保罗·罗默',
        localName: 'Paul Romer',
        years: '1955—',
        idea: '思想、知识溢出、收益递增与内生增长。',
        works: ['《内生技术变迁》'],
      },
      arthur: {
        name: '威廉·布莱恩·阿瑟',
        localName: 'W. Brian Arthur',
        years: '1946—',
        idea: '收益递增、路径依赖、学习与涌现。',
        works: ['《收益递增与路径依赖》', '《复杂经济学》'],
      },
    },
  },
}[lang];

const revolutionIndex = new Map<string, string>();
let revolutionCount = 0;
for (const era of copy.eras) {
  if (era.revolution) {
    revolutionCount += 1;
    revolutionIndex.set(era.id, String(revolutionCount).padStart(2, '0'));
  }
}

const people = peopleBase.map((person) => {
  const track = tracks[person.track];
  const translated = copy.people[person.id];
  return {
    ...person,
    ...translated,
    track: track.column,
    cardOffset: track.cardOffset,
    trackCode: track.code,
    trackLabel: copy.tracks[person.track],
  };
});

const breadcrumbSchema = generateBreadcrumbSchema(
  [
    { name: lang === 'zh' ? '首页' : 'Home', path: '/' },
    {
      name: lang === 'zh' ? 'AI 时代的经济学' : 'Economics After AI',
      path: '/economics-after-ai',
    },
    { name: copy.title },
  ],
  lang
);
---

<Layout title={`${copy.title} | ${t('home.name')}`} lang={lang} description={copy.description}>
  <StructuredData data={breadcrumbSchema} />

  <main
    class="economics-map-page relative min-h-screen overflow-hidden px-5 py-20 md:px-10 md:py-24 lg:px-14"
  >
    <AtlasField class="absolute inset-0 h-full w-full opacity-[0.64]" variant="circulation" />

    <div class="relative z-10 mx-auto max-w-[1680px]">
      <a href={`/${lang}/economics-after-ai`} class="atlas-back-link">
        <span aria-hidden="true">←</span>
        {copy.back}
      </a>

      <header class="map-header mt-8 grid gap-8 border-b pb-10 xl:grid-cols-12 xl:items-end">
        <div class="xl:col-span-4">
          <p class="atlas-kicker economics-kicker">P02 / {copy.eyebrow}</p>
          <p class="atlas-credit mt-6 max-w-sm">{copy.mapLabel}</p>
        </div>
        <div class="xl:col-span-8">
          <h1 class="text-atlas-ink font-serif text-6xl leading-[0.9] md:text-7xl xl:text-8xl">
            {copy.title}
          </h1>
          <p class="map-intro mt-6 max-w-4xl">{copy.intro}</p>
        </div>
      </header>

      <section class="legend" aria-labelledby="map-legend-title">
        <div>
          <p id="map-legend-title" class="atlas-kicker">{copy.legendTitle}</p>
        </div>
        <ol>
          {
            Object.entries(tracks).map(([key, track]) => (
              <li>
                <span>{track.code}</span>
                <b>{copy.tracks[key]}</b>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="history-tree" aria-label={copy.title}>
        <div class="tree-rails" aria-hidden="true">
          {Object.values(tracks).map((track) => <i style={`--rail-column: ${track.column};`} />)}
        </div>

        <ol class="tree-eras">
          {
            copy.eras.map((era) => {
              const eraPeople = people.filter((person) => person.era === era.id);
              const activeTrackCodes = new Set(eraPeople.map((person) => person.trackCode));
              return (
                <li class="era-block">
                  <header class="era-header">
                    <div>
                      <span>{era.number}</span>
                      <span class="era-period">{era.period}</span>
                    </div>
                    <div>
                      {era.revolution && (
                        <p class="era-revolution">
                          <span aria-hidden="true">★</span>
                          REV {revolutionIndex.get(era.id) ?? '00'} · {era.revolution}
                        </p>
                      )}
                      <h2>{era.title}</h2>
                      <p class="era-note">{era.note}</p>
                    </div>
                    <div class="era-bridge">
                      <div class="era-track-index" aria-hidden="true">
                        {Object.values(tracks).map((track) => (
                          <i class:list={{ active: activeTrackCodes.has(track.code) }}>
                            <b>{track.code}</b>
                          </i>
                        ))}
                      </div>
                      <div class="era-bridge-copy">
                        <span>{copy.bridgeLabel}</span>
                        <p title={era.bridge}>{era.bridge}</p>
                      </div>
                    </div>
                  </header>

                  <div class="era-grid">
                    {eraPeople.map((person) => (
                      <EconomistTreeNode
                        person={person}
                        plannedLabel={copy.plannedLabel}
                        readLabel={copy.readLabel}
                        worksLabel={copy.worksLabel}
                      />
                    ))}
                  </div>
                </li>
              );
            })
          }
        </ol>
      </section>

      <footer class="map-footer">
        <p class="atlas-kicker economics-kicker">P02 / 01 / OPEN INDEX</p>
        <h2>{copy.footerTitle}</h2>
        <p class="map-footer-note">{copy.footer}</p>
        <p class="map-footer-hook">{copy.footerHook}</p>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .economics-map-page {
    --economics-accent: var(--color-track-economics);
    --economics-accent-ink: #76623f;
    --economics-wash: color-mix(in srgb, var(--economics-accent) 10%, transparent);
    --economics-card: color-mix(
      in srgb,
      var(--color-morandi-paper) 94%,
      var(--economics-accent) 6%
    );
    --economics-card-line: color-mix(in srgb, var(--economics-accent-ink) 38%, transparent);
    --economics-rail: color-mix(in srgb, var(--economics-accent-ink) 60%, transparent);
    --economics-rail-strong: color-mix(in srgb, var(--economics-accent-ink) 80%, transparent);
    background:
      radial-gradient(
        circle at 82% 4%,
        color-mix(in srgb, var(--economics-accent) 19%, transparent),
        transparent 29rem
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-morandi-bg) 91%, var(--economics-accent) 9%) 0,
        var(--color-morandi-bg) 34rem,
        color-mix(in srgb, var(--color-morandi-bg) 96%, var(--economics-accent) 4%) 100%
      );
  }

  .economics-kicker {
    color: var(--economics-accent-ink);
  }

  .atlas-back-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 2.75rem;
    color: var(--economics-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-header {
    position: relative;
    border-color: var(--economics-card-line);
  }

  .map-header::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    content: '';
    background: linear-gradient(
      90deg,
      var(--economics-rail-strong),
      var(--economics-accent) 38%,
      transparent 72%
    );
  }

  .map-header h1 {
    color: color-mix(in srgb, var(--color-atlas-ink) 90%, var(--economics-accent-ink) 10%);
  }

  .map-intro {
    color: color-mix(in srgb, var(--color-atlas-ink) 75%, transparent);
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.85;
  }

  .legend {
    display: grid;
    gap: 1.5rem;
    margin-top: 1px;
    padding: 1.15rem;
    border-bottom: 1px solid var(--economics-card-line);
    background: linear-gradient(90deg, var(--economics-wash), transparent 76%);
  }

  .legend ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .legend li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    min-width: 0;
    padding: 0.35rem;
    border-left: 1px solid var(--economics-card-line);
  }

  .legend li span,
  .legend li b {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legend li span {
    display: grid;
    flex: none;
    place-items: center;
    min-width: 2.35rem;
    min-height: 1.45rem;
    color: var(--color-morandi-paper);
    background: var(--economics-accent-ink);
  }

  .legend li b {
    color: color-mix(in srgb, var(--color-atlas-ink) 62%, transparent);
    font-weight: 400;
  }

  .history-tree {
    position: relative;
    margin-top: 2.5rem;
    background: linear-gradient(180deg, var(--economics-wash), transparent 22rem);
  }

  .tree-rails {
    display: none;
  }

  .tree-eras {
    position: relative;
  }

  .era-block {
    position: relative;
    padding: 0 0 2.75rem 1.75rem;
  }

  .era-block::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    content: '';
    background: var(--economics-rail);
  }

  .era-block::after {
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 0.7rem;
    height: 0.7rem;
    content: '';
    border: 1px solid var(--economics-accent-ink);
    border-radius: 999px;
    background: var(--color-morandi-bg);
    transform: translateX(-50%);
  }

  .era-header {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--economics-card-line);
    border-left: 3px solid var(--economics-accent-ink);
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--color-morandi-paper) 86%, var(--economics-accent) 14%),
      color-mix(in srgb, var(--color-morandi-bg) 96%, transparent)
    );
  }

  .era-header > div:first-child {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .era-header > div:first-child span {
    color: color-mix(in srgb, var(--economics-accent) 44%, transparent);
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 0.8;
  }

  .era-period,
  .era-bridge span {
    color: var(--economics-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .era-revolution {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    width: fit-content;
    margin-bottom: 0.65rem;
    padding: 0.3rem 0.55rem;
    color: var(--color-morandi-paper);
    background: var(--economics-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .era-revolution span {
    color: color-mix(in srgb, var(--economics-accent) 78%, var(--color-morandi-paper));
  }

  .era-header h2,
  .map-footer h2 {
    color: var(--color-atlas-ink);
    font-family: var(--font-serif);
  }

  .era-header h2 {
    font-size: clamp(1.65rem, 2.6vw, 2.7rem);
    line-height: 1.03;
  }

  .era-note,
  .era-bridge p,
  .map-footer-note {
    color: color-mix(in srgb, var(--color-atlas-ink) 72%, transparent);
    line-height: 1.75;
  }

  .era-note {
    max-width: 48rem;
    margin-top: 0.55rem;
    font-size: 0.78rem;
  }

  .era-bridge {
    display: grid;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--economics-card-line);
  }

  .era-bridge p {
    display: -webkit-box;
    margin-top: 0.3rem;
    overflow: hidden;
    font-size: 0.68rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .era-track-index {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .era-track-index i {
    display: grid;
    place-items: center;
    min-height: 1.15rem;
    border-top: 2px solid color-mix(in srgb, var(--economics-accent) 24%, transparent);
    color: color-mix(in srgb, var(--color-atlas-ink) 42%, transparent);
    font-family: var(--font-mono);
    font-size: 0.45rem;
    font-style: normal;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--color-morandi-paper) 44%, transparent);
  }

  .era-track-index i.active {
    border-color: var(--economics-accent-ink);
    color: var(--economics-accent-ink);
    background: color-mix(in srgb, var(--economics-accent) 18%, transparent);
  }

  .era-track-index b {
    font-weight: 500;
  }

  .era-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
    padding-top: 1rem;
  }

  .map-footer {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 1rem 1rem;
    border-top: 2px solid var(--economics-accent-ink);
    background: linear-gradient(90deg, var(--economics-wash), transparent 78%);
  }

  .map-footer h2 {
    font-size: clamp(2rem, 3.2vw, 3.5rem);
    line-height: 1;
  }

  .map-footer-note {
    max-width: 48rem;
    font-size: 0.95rem;
  }

  .map-footer-hook {
    max-width: 48rem;
    margin-top: 0.4rem;
    padding: 0.8rem 1rem;
    border-left: 2px solid var(--economics-accent-ink);
    background: var(--economics-wash);
    color: color-mix(in srgb, var(--color-atlas-ink) 80%, transparent);
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .legend {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: start;
    }

    .legend ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .era-header {
      grid-template-columns: 11rem minmax(0, 1fr);
    }

    .era-bridge {
      grid-column: 2;
    }

    .era-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .map-footer {
      grid-template-columns: 12rem minmax(0, 1fr);
    }

    .map-footer-note,
    .map-footer-hook {
      grid-column: 2;
    }
  }

  @media (min-width: 64rem) and (max-width: 89.999rem) {
    .era-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 90rem) {
    .legend ol {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .history-tree {
      margin-top: 3rem;
    }

    .tree-rails {
      position: absolute;
      inset: 1.25rem 0 2.5rem calc(13rem + 1.25rem);
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1rem;
      pointer-events: none;
    }

    .tree-rails i {
      position: relative;
      grid-column: var(--rail-column) / span 2;
    }

    .tree-rails i::after {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      content: '';
      background: var(--economics-rail);
      box-shadow: 0 0 0 1px var(--economics-wash);
    }

    .era-block {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 1.25rem;
      padding: 1.25rem 0 1.5rem;
      border-top: 1px solid var(--economics-card-line);
    }

    .era-block::before,
    .era-block::after {
      display: none;
    }

    .era-header {
      position: relative;
      z-index: 2;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
      align-items: start;
      align-self: start;
      padding: 1rem;
      border-color: var(--economics-card-line);
      border-left-color: var(--economics-accent-ink);
      background: color-mix(in srgb, var(--color-morandi-paper) 88%, var(--economics-accent) 12%);
      backdrop-filter: blur(8px);
    }

    .era-block:nth-child(even) .era-header {
      background: color-mix(in srgb, var(--color-morandi-bg) 90%, var(--economics-accent) 10%);
    }

    .era-header > div:first-child {
      display: grid;
      gap: 0.55rem;
    }

    .era-header > div:first-child span {
      font-size: 2.5rem;
    }

    .era-header h2 {
      font-size: 1.35rem;
    }

    .era-note {
      display: none;
    }

    .era-bridge {
      grid-column: auto;
      gap: 0.45rem;
      padding-top: 0.6rem;
    }

    .era-bridge-copy > span {
      display: none;
    }

    .era-bridge p {
      display: block;
      margin-top: 0;
      overflow: hidden;
      line-height: 1.55;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .era-grid {
      position: relative;
      z-index: 2;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1rem;
      align-items: start;
      align-self: start;
      padding-top: 0;
    }
  }

  @media (max-width: 47.999rem) {
    .map-intro {
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .legend {
      gap: 1rem;
      padding: 0.9rem;
    }

    .legend ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .legend li {
      display: grid;
      gap: 0.4rem;
      align-content: start;
      align-items: start;
      padding: 0 0 0 0.45rem;
    }

    .legend li span {
      min-width: 2.1rem;
      min-height: 1.3rem;
      justify-self: start;
    }

    .legend li b {
      font-size: 0.52rem;
      line-height: 1.35;
    }

    .history-tree {
      margin-top: 2rem;
    }

    .era-block {
      padding-bottom: 1.5rem;
    }

    .era-header {
      gap: 0.7rem;
      padding: 0.85rem;
    }

    .era-header h2 {
      font-size: 1.55rem;
    }

    .era-note {
      display: none;
    }

    .era-bridge {
      gap: 0.4rem;
      padding-top: 0.55rem;
    }

    .era-bridge p {
      display: block;
      margin-top: 0;
      overflow: hidden;
      line-height: 1.5;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-back-link {
      scroll-behavior: auto;
    }
  }
</style>
