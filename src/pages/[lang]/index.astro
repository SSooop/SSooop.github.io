---
import HomePage from '../../components/HomePage.astro';
import type { SupportedLocale } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang: SupportedLocale = Astro.params.lang === 'zh' ? 'zh' : 'en';
---

<HomePage lang={lang} canonical={`/${lang}/`} />
