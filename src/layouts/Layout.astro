---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

import SocialFooter from '../components/SocialFooter';
import StructuredData from '../components/StructuredData.astro';
import MetaTags from '../components/MetaTags.astro';

import { useTranslations, type SupportedLocale } from '../i18n/ui';
import { generateSiteIdentityGraph, generateWebPageSchema } from '../utils/structuredData';
import { absoluteUrl } from '../config/site';
import type { CitationMeta } from '../utils/citation';

interface Props {
  title: string;
  lang?: SupportedLocale;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  canonical?: string;
  alternateLanguages?: Record<string, string>;
  citation?: CitationMeta;
  emitWebPageSchema?: boolean;
}

const {
  title,
  lang = 'en',
  description,
  image,
  type,
  keywords,
  canonical,
  alternateLanguages: alternateLanguagesOverride,
  citation,
  emitWebPageSchema = true,
} = Astro.props;

const currentPath = Astro.url.pathname;
const targetLang = lang === 'en' ? 'zh' : 'en';
const isSiteRoot = currentPath === '/';
const isHome =
  currentPath === `/${lang}/` || currentPath === `/${lang}` || (isSiteRoot && lang === 'en');

const t = useTranslations(lang as SupportedLocale);
const pageTitle = title;
const pageDescription = description || t('meta.desc');
const canonicalPath = canonical || currentPath;

// Generate alternate language links for hreflang
const defaultAlternateLanguages = {
  en: currentPath.replace(/^\/zh\//, '/en/').replace(/^\/en\//, '/en/'),
  zh: currentPath.replace(/^\/en\//, '/zh/').replace(/^\/zh\//, '/zh/'),
  'x-default': currentPath.replace(/^\/zh\//, '/en/').replace(/^\/en\//, '/en/'),
};
const alternateLanguages = alternateLanguagesOverride || defaultAlternateLanguages;
const targetPath = alternateLanguages[targetLang] || `/${targetLang}/`;
const pageSchema =
  type === 'article' || isSiteRoot || !emitWebPageSchema
    ? undefined
    : generateWebPageSchema({
        title: pageTitle,
        description: pageDescription,
        url: canonicalPath,
        lang,
      });
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="IntelliPharma Insights / 智药深瞳"
      href={absoluteUrl('/rss.xml')}
    />

    <!-- Meta Tags -->
    <MetaTags
      title={pageTitle}
      description={pageDescription}
      image={image}
      type={type}
      keywords={keywords}
      canonical={canonicalPath}
      alternateLanguages={alternateLanguages}
      lang={lang}
      citation={citation}
    />

    <!-- Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    {isSiteRoot && <StructuredData data={generateSiteIdentityGraph()} />}
    {pageSchema && <StructuredData data={pageSchema} />}
  </head>
  <body
    class="selection:bg-site-neutral-hover flex min-h-screen flex-col overflow-x-hidden selection:text-white"
  >
    <!-- Global Controls - Navigation -->
    {
      (!isSiteRoot || lang === 'en') && (
        <nav
          class="fixed top-5 right-5 z-50 flex items-center border border-[color:var(--atlas-line)] bg-[color:color-mix(in_srgb,var(--color-morandi-bg)_86%,transparent)] font-mono text-[10px] tracking-[0.14em] uppercase shadow-[0_12px_36px_rgb(35_38_36/0.08)] backdrop-blur-md md:top-7 md:right-7"
          aria-label={lang === 'zh' ? '语言与导航' : 'Language and navigation'}
        >
          {!isHome && (
            <a
              href={`/${lang}/`}
              class="text-atlas-ink hover:bg-atlas-ink border-r border-[color:var(--atlas-line)] px-3 py-2 transition-colors hover:text-white"
              aria-label={lang === 'zh' ? '返回首页' : 'Go to home page'}
            >
              {lang === 'zh' ? '首页' : 'HOME'}
            </a>
          )}
          <a
            href={targetPath}
            class="text-atlas-ink hover:bg-atlas-signal px-3 py-2 transition-colors hover:text-white"
            aria-label={`Switch to ${lang === 'en' ? 'Chinese' : 'English'} language`}
          >
            {lang === 'en' ? 'CN' : 'EN'}
          </a>
        </nav>
      )
    }

    <!-- Main Content -->
    <div class="flex-1">
      <slot />
    </div>

    <!-- Footer -->
    <SocialFooter client:visible lang={lang} t={t} />
  </body>
</html>
